---
/**
 * Platform Index — Halaman utama per platform untuk semua topik tutorial
 * URL: /tutorial/{platform}/
 *
 * Mengumpulkan semua topic hubs untuk satu platform + link ke service page
 */
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.svelte';
import Footer from '../../../components/Footer.svelte';
import StickyCTA from '../../../components/StickyCTA.svelte';
import AdsenseSlot from '../../../components/AdsenseSlot.astro';
import { ChevronRight, BookOpen } from 'lucide-svelte';

export async function getStaticPaths() {
    const postsModule = await import('../../../data/posts.json');
    const posts = postsModule.default || postsModule;

    const PLATFORM_DETECTORS = {
        'facebook-ads': { name: 'Facebook Ads', service: 'jasa-iklan-facebook', detectors: ['facebook', 'fb ads', 'meta ads', 'meta pixel'] },
        'instagram-ads': { name: 'Instagram Ads', service: 'jasa-iklan-instagram', detectors: ['instagram', 'ig ads', 'reels ads'] },
        'tiktok-ads': { name: 'TikTok Ads', service: 'jasa-iklan-tiktok', detectors: ['tiktok', 'fyp', 'spark ads'] },
        'google-ads': { name: 'Google Ads', service: 'jasa-iklan-google', detectors: ['google ads', 'search ads', 'display ads'] },
        'youtube-ads': { name: 'YouTube Ads', service: 'jasa-iklan-youtube', detectors: ['youtube', 'video ads'] },
        'digital-marketing': { name: 'Digital Marketing', service: 'jasa-digital-marketing', detectors: ['digital marketing', 'seo'] },
        'website': { name: 'Website', service: 'jasa-pembuatan-website', detectors: ['website', 'landing page'] },
    };

    const TOPICS = [
        { slug: 'cara-pasang', label: 'Cara Pasang', desc: 'Tutorial step-by-step pemasangan' },
        { slug: 'cara-optimasi', label: 'Cara Optimasi', desc: 'Strategi optimasi untuk hasil terbaik' },
        { slug: 'apa-itu', label: 'Apa Itu', desc: 'Penjelasan konsep & terminologi' },
        { slug: 'tips', label: 'Tips & Trik', desc: 'Tips praktis dari praktisi' },
        { slug: 'panduan', label: 'Panduan', desc: 'Panduan lengkap komprehensif' },
    ];

    const paths = [];

    for (const [platformSlug, config] of Object.entries(PLATFORM_DETECTORS)) {
        // Count posts per topic
        const topicCounts = {};
        let totalPosts = 0;

        for (const post of posts) {
            const kw = (post.keyword_normalized || post.title || '').toLowerCase();
            const isInfo = kw.startsWith('cara ') || kw.startsWith('apa ') || kw.includes('tips ') ||
                          kw.includes('panduan ') || kw.startsWith('belajar ') || kw.startsWith('tutorial') ||
                          kw.startsWith('langkah');
            if (!isInfo) continue;
            if (!config.detectors.some(d => kw.includes(d))) continue;

            let topic = 'cara-pasang';
            if (kw.startsWith('apa ')) topic = 'apa-itu';
            else if (kw.startsWith('cara optimasi')) topic = 'cara-optimasi';
            else if (kw.startsWith('tips') || kw.includes(' tips ')) topic = 'tips';
            else if (kw.startsWith('panduan')) topic = 'panduan';

            topicCounts[topic] = (topicCounts[topic] || 0) + 1;
            totalPosts++;
        }

        if (totalPosts < 5) continue; // Skip platform with too few posts

        paths.push({
            params: { platform: platformSlug },
            props: {
                platform: platformSlug,
                platformName: config.name,
                serviceSlug: config.service,
                topics: TOPICS.map(t => ({
                    ...t,
                    count: topicCounts[t.slug] || 0,
                })).filter(t => t.count > 0),
                totalPosts,
            },
        });
    }

    return paths;
}

const { platform, platformName, serviceSlug, topics, totalPosts } = Astro.props;

const pageTitle = `Tutorial ${platformName} Lengkap — ${totalPosts}+ Artikel Praktis | Beriklan`;
const pageDesc = `Pelajari ${platformName} dari dasar hingga lanjutan. ${totalPosts}+ artikel tutorial, tips, dan panduan ${platformName} terlengkap untuk UMKM Indonesia.`;
const canonical = `https://beriklan.co.id/tutorial/${platform}/`;
---

<Layout
    title={pageTitle}
    description={pageDesc}
    canonical={canonical}
    ogType="website"
>
    <Navbar client:only="svelte" />
    <StickyCTA client:only="svelte" />

    <header class="hero relative pt-28 md:pt-40 pb-12 md:pb-16 overflow-hidden bg-gradient-to-br from-white via-soft to-beige">
        <div class="absolute inset-0 opacity-[0.4] pointer-events-none hero-grid"></div>
        <div class="abs-blob abs-blob-1"></div>
        <div class="container mx-auto px-6 max-w-4xl relative z-10">
            <nav class="flex items-center gap-2 text-sm text-muted mb-6">
                <a href="/" class="hover:text-accent">Beranda</a>
                <ChevronRight class="w-3 h-3" />
                <a href="/tutorial/" class="hover:text-accent">Tutorial</a>
                <ChevronRight class="w-3 h-3" />
                <span class="text-ink font-semibold">{platformName}</span>
            </nav>

            <div class="hero-eyebrow inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 text-ink font-semibold rounded-full text-xs tracking-wider uppercase shadow-sm mb-5">
                <BookOpen class="w-3.5 h-3.5 text-accent" />
                Tutorial Lengkap · {totalPosts}+ Artikel
            </div>

            <h1 class="font-display font-extrabold text-4xl md:text-5xl text-ink leading-[1.1] tracking-tight mb-5">
                <span class="anim-fade-up">Tutorial {platformName}</span><br/>
                <span class="anim-fade-up text-transparent bg-clip-text bg-gradient-to-r from-primary-2 to-accent" style="animation-delay: 80ms;">
                    untuk Bisnis Indonesia
                </span>
            </h1>

            <p class="text-base md:text-lg text-muted leading-relaxed mb-7 max-w-2xl">
                Pelajari {platformName} dari instalasi dasar hingga strategi lanjutan.
                Disusun oleh tim Beriklan yang mengelola 100+ campaign aktif untuk UMKM Indonesia.
            </p>

            <div class="flex flex-wrap gap-3">
                <a
                    href={`/${serviceSlug}/`}
                    class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-white font-bold rounded-full hover:bg-orange-500 transition shadow-lg"
                >
                    Lihat Layanan {platformName} →
                </a>
                <a
                    href={`https://wa.me/62811919328?text=${encodeURIComponent(`Halo Beriklan, saya butuh bantuan ${platformName}.`)}`}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 px-6 py-3 bg-white border-2 border-ink text-ink font-bold rounded-full hover:bg-ink hover:text-white transition"
                >
                    Tanya via WhatsApp
                </a>
            </div>
        </div>
    </header>

    <section class="py-12 md:py-16 bg-white">
        <div class="container mx-auto px-6 max-w-4xl">
            <h2 class="text-2xl md:text-3xl font-display font-bold text-ink mb-8">
                Topik Tutorial {platformName}
            </h2>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                {topics.map((t) => (
                    <a
                        href={`/tutorial/${platform}/${t.slug}/`}
                        class="block bg-soft border border-gray-100 rounded-2xl p-6 hover:border-accent hover:shadow-pop transition group"
                    >
                        <h3 class="font-display font-bold text-xl text-ink group-hover:text-accent mb-2">
                            {t.label}
                        </h3>
                        <p class="text-sm text-muted mb-3">{t.desc}</p>
                        <span class="inline-flex items-center gap-1 text-xs font-bold text-accent">
                            {t.count} artikel →
                        </span>
                    </a>
                ))}
            </div>

            <div class="my-10">
                <AdsenseSlot slot="in-article" format="rectangle" />
            </div>
        </div>
    </section>

    <Footer />
    <AdsenseSlot slot="anchor" />
</Layout>
