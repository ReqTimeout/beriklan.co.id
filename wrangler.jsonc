{
  "name": "beriklanweb",
  "main": "src/worker-entry.js",
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beriklan-seo",
      "database_id": "0e71d6e3-231f-40a1-ac6b-6defc3976efd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "QUEUE",
      "bucket_name": "idberiklan"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    // Worker-first untuk SEMUA path. Penting: host www→apex 301 + blog enrichment
    // (D1 render) hanya jalan kalau worker dieksekusi; asset-first bypass worker.
    "run_worker_first": ["/*"]
  },
  "triggers": {
    // 1 slot cron beriklanweb (2026-09-25): */15 dipindah ke time-gate di dalam
    // scheduled() karena CF auto-disabled setelah 3× fail. Total crons:
    //   beriklanweb: 1 (`0 * * * *`)
    //   beriklanmy: 1 (`0 * * * *`)
    //   total account: 2/5 — masih 3 slot kosong.
    "crons": [
      "0 * * * *"
    ]
  }
}
